load("@bazel_lib//lib:write_source_files.bzl", "write_source_file")
load("@dh_buildlib//ts/docker:defs.bzl", "node_binary_image")

node_binary_image(
    name = "rest-api",
    data = ["//rest-api/src"],
    entry_point = "//rest-api/src:index.js",
    ports = ["8000"],
    visibility = ["//:docker-image-users"],
)

write_source_file(
    # Rule to snapshot the resulting REST API to the repository.
    # Only use this, if you need to offer a stable API and need to keep track
    # of changes (otherwise it's just noise).
    name = "api-snapshot",
    in_file = "//rest-api/src:api.json",
    out_file = "api-snapshot.json",
)
