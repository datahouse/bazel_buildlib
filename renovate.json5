{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  automerge: true,

  extends: [":semanticCommitsDisabled"],

  packageRules: [
    // Do not automerge major bazel lib updates in buildlib:
    // They are potentially breaking for downstream.
    {
      matchFileNames: ["buildlib/**"],
      matchManagers: ["bazel-module"],
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    // Do not automerge major npm non-dev dependencies in buildlib:
    // They are potentially breaking for downstream.
    {
      matchFileNames: ["buildlib/**"],
      matchManagers: ["npm"],
      matchDepTypes: ["!devDependencies"],
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    // Trigger buildlib boilerplate write if we update pnpm.
    //
    // We need to do this to update the renovate config.
    //
    // Repositories using dh_buildlib do this when they upgrade dh_buildlib.
    // However, inside dh_buildlib, we need to do it right when we upgrade pnpm;
    // otherwise tests fail.
    {
      matchManagers: ["npm"],
      matchPackageNames: ["pnpm"],
      postUpgradeTasks: {
        commands: ["/renovate-commands/dh_buildlib_setup.write.sh"],
        executionMode: "branch",
      },
    },
    // Trigger buildlib boilerplate write if we update rules_nodjes
    //
    // We need to do this to update the renovate config.
    //
    // Repositories using dh_buildlib do this when they upgrade dh_buildlib.
    // However, inside dh_buildlib, we need to do it right when we upgrade
    // rules_nodejs; otherwise tests fail.
    {
      matchManagers: ["bazel-module"],
      matchPackageNames: ["rules_nodejs"],
      postUpgradeTasks: {
        commands: [
          "/renovate-commands/update-bzlmod-lock.sh",
          "/renovate-commands/dh_buildlib_setup.write.sh",
        ],
        executionMode: "branch",
      },
    },
    { matchPackageNames: ["node"], allowedVersions: "<= 22.15.1" },
  ],
  constraints: {
    pnpm: "10.13.1",
  },
}
