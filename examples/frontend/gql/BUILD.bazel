load("@dh_buildlib//ts:defs.bzl", "ts_library")
load("@npm//:@graphql-codegen/cli/package_json.bzl", _gql_codegen = "bin")

_gql_codegen.graphql_codegen(
    name = "codegen",
    srcs = [
        ":gql-codegen.yml",
        "//:node_modules/@graphql-codegen/client-preset",
        "//api:schema",
        "//frontend/src:ts_srcs",
    ],
    outs = [
        "gql.ts",
        "graphql.ts",
        "index.ts",
    ],
    args = [
        "--config",
        "frontend/gql/gql-codegen.yml",
    ],
)

ts_library(
    name = "gql",
    srcs = [":codegen"],
    visibility = [
        "//frontend:__subpackages__",
    ],
    deps = [
        "//:node_modules/@graphql-typed-document-node/core",
        "//:node_modules/graphql",
    ],
)
