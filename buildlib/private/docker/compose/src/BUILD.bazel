load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("//private:ts_library.bzl", "ts_library")

ts_library(
    name = "src",
    srcs = glob(["**/*.ts"]),
    visibility = [
        "//private/docker/compose/test:__pkg__",
        "//private/prisma/src:__pkg__",
    ],
    deps = [
        "//:node_modules/@types/dockerode",
        "//:node_modules/@types/js-yaml",
        "//:node_modules/@types/node",
        "//:node_modules/argparse",
        "//:node_modules/dockerode",
        "//:node_modules/js-yaml",
        "//private/docker/lib/src",
        "//private/docker/load/src",
        "//private/js-lib/src",
    ],
)

js_binary(
    name = "dc-processor",
    data = [":src"],
    entry_point = "dc-processor.js",
    visibility = ["//private/docker/compose:__pkg__"],
)

js_binary(
    name = "dc-runner",
    data = [":src"],
    entry_point = "dc-runner.js",
    visibility = ["//private/docker/compose:__pkg__"],
)
