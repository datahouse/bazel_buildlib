load("@dh_buildlib//prisma:defs.bzl", "prisma_generate", "prisma_schema")
load("@dh_buildlib//prisma/generators:defs.bzl", "prisma_client_js")

prisma_schema(
    name = "schema",
    db_url_env = "DATABASE_URL",
    schema = "schema.prisma",
    validate_db_url = "postgres://localhost/",
)

prisma_generate(
    name = "generate",
    generators = [":prisma-client.generator"],
    schema = ":schema",
)

prisma_client_js(
    name = "prisma-client",
    generate = ":generate",
)
