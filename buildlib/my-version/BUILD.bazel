load("@aspect_bazel_lib//lib:jq.bzl", "jq")
load("//:defs.bzl", "json_to_ts")
load(":private.bzl", "gen_my_version")

gen_my_version(
    name = "txt",
    out = "my-version.txt",
    visibility = ["//visibility:public"],
)

jq(
    name = "json",
    srcs = ["my-version.txt"],
    out = "my-version.json",
    args = [
        "--raw-input",
        "--slurp",
    ],
    filter = ".",
    visibility = ["//visibility:public"],
)

json_to_ts(
    name = "ts",
    src = "my-version.json",
    out = "myVersion.ts",
    type = "string",
    visibility = ["//visibility:public"],
)
