load("//private:assert_failure_test.bzl", "assert_failure_test")
load("//private:ts_library.bzl", "ts_library")

# Broken ts_library target for testing:
# It depends on a library that requires the DOM, but doesn't declare uses_dom itself.
ts_library(
    name = "lib_under_test",
    srcs = [],  # dependencies only, no sources.
    tags = ["manual"],
    deps = [
        "//private/ts/test/js_env_deps/dom_lib",
    ],
)

assert_failure_test(
    name = "test_dom_failure",
    expected_failure = """@@//private/ts/test/js_env_deps:tsconfig.gen has deps requiring the DOM but doesn't set uses_dom = True.
The following dependencies depend on the dom:
- @@//private/ts/test/js_env_deps/dom_lib:dom_lib
To fix this you need to do either of the following
- Add uses_dom = True (if the target is intended for the browser)
- Remove the offending libraries
- Remove uses_dom from the offending libraries (if they don't use the DOM)""",
    target_under_test = ":tsconfig.gen",  # generated by :lib_under_test
)
