load("@dh_buildlib//prisma:defs.bzl", "prisma_generate", "prisma_schema")
load("@dh_buildlib//prisma/generators:defs.bzl", "prisma_client")

prisma_schema(
    name = "schema",
    srcs = ["schema.prisma"],
)

prisma_generate(
    name = "generate",
    generators = [":client.generator"],
    schema = ":schema",
)

prisma_client(
    name = "client",
    generate = ":generate",
    visibility = [
        "//:__subpackages__",
    ],
)
