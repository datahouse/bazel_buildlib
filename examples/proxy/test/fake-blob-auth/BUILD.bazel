load("@dh_buildlib//ts:defs.bzl", "ts_library")
load("@dh_buildlib//ts/docker:defs.bzl", "node_binary_image")

ts_library(
    name = "src",
    testonly = 1,
    srcs = glob(["**/*.ts"]),
    visibility = [
        # Allow the test to use this library to access FakePrismaData.ts
        # This is a bit ugly (a separate tiny library would be cleaner), but it
        # is good enough for tests.
        "//proxy/test:__pkg__",
    ],
    deps = [
        "//:node_modules/express",
        "//proxy/blob-auth/src",
    ],
)

node_binary_image(
    name = "fake-blob-auth",
    testonly = 1,
    data = [":src"],
    entry_point = ":index.js",
    ports = ["8000"],
    visibility = ["//proxy/test:__pkg__"],
)
