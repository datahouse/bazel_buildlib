load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("//private:ts_library.bzl", "ts_library")

ts_library(
    name = "src",
    srcs = glob(["**/*.ts"]),
    visibility = [
        "//private/prisma:__pkg__",
        "//private/prisma/test:__pkg__",
    ],
    deps = [
        "//:node_modules/@renovatebot/good-enough-parser",
        "//:node_modules/@testcontainers/postgresql",
        "//:node_modules/@types/node",
        "//:node_modules/argparse",
        "//private/docker/compose/src",
        "//private/docker/load/src",
        "//private/js-lib/src",
    ],
)

js_binary(
    name = "dev-runner",
    data = [
        ":src",
    ],
    entry_point = "dev-runner.js",
    visibility = ["//private/prisma:__pkg__"],
)

js_binary(
    name = "generate",
    data = [
        ":src",
    ],
    entry_point = "generate.js",
    visibility = ["//private/prisma:__pkg__"],
)

js_binary(
    name = "validate-schema",
    data = [
        ":src",
    ],
    entry_point = "validate-schema.js",
    visibility = ["//private/prisma:__pkg__"],
)
