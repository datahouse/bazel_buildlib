load("@bazel_lib//:bzl_library.bzl", "bzl_library")

exports_files([
    ".swcrc",
])

bzl_library(
    name = "bzl",
    srcs = glob(["**/*.bzl"]),
    visibility = [
        "//private:__subpackages__",
        "//setup/defs:__pkg__",
        "//ts:__subpackages__",
    ],
    deps = [
        "//private:npm_js_binary",
        "//private:prettier_format",
        "@aspect_rules_swc//swc:defs",
        "@aspect_rules_ts//ts:defs",
        "@bazel_lib//lib:write_source_files",
        "@bazel_skylib//rules:common_settings",
        "@bazel_skylib//rules:copy_file",
        "@bazel_skylib//rules:select_file",
    ],
)
