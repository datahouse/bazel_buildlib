bazel_dep(name = "aspect_rules_js", version = "2.9.2")
bazel_dep(name = "aspect_rules_ts", version = "3.8.3")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_oci", version = "2.2.7")
bazel_dep(name = "tar.bzl", version = "0.7.0")
bazel_dep(name = "dh_buildlib", version = "0.0.0")

# When setting up in a different repository this should be
# `git_override` (use it-bazel-new-repo to set it up).
local_path_override(
    module_name = "dh_buildlib",
    path = "../buildlib",
)

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
use_repo(npm, "npm")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(ts_version_from = "@npm//:typescript/resolved.json")
use_repo(rules_ts_ext, "npm_typescript")

# Docker images your project needs.
# - `node_image` is required by the base setup.
# - Remove others if you do not need them.

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "nginx_image",
    digest = "sha256:c881927c4077710ac4b1da63b83aa163937fb47457950c267d92f7e4dedf4aec",
    image = "index.docker.io/library/nginx",
    platforms = ["linux/amd64"],
    tag = "1.29.4",  # ignored, doc only
)
oci.pull(
    name = "node_image",
    digest = "sha256:b2b2184ba9b78c022e1d6a7924ec6fba577adf28f15c9d9c457730cc4ad3807a",
    image = "index.docker.io/library/node",
    platforms = ["linux/amd64"],
    tag = "24.13.0",  # ignored, doc only
)
oci.pull(
    name = "postgres_image",
    digest = "sha256:5773fe724c49c42a7a9ca70202e11e1dff21fb7235b335a73f39297d200b73a2",
    image = "index.docker.io/library/postgres",
    platforms = ["linux/amd64"],
    tag = "18.1",  # ignored, doc only
)
use_repo(oci, "nginx_image", "nginx_image_linux_amd64", "node_image", "node_image_linux_amd64", "postgres_image", "postgres_image_linux_amd64")
