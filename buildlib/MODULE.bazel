module(
    name = "dh_buildlib",
    bazel_compatibility = [
        ">=8.5.0",  # for module_ctx.facts
    ],
)

# Non-Dev Dependencies

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "rules_python", version = "2.4.5")
bazel_dep(name = "aspect_rules_swc", version = "2.7.6")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "jq.bzl", version = "0.7.1")
bazel_dep(name = "tar.bzl", version = "0.10.9")
bazel_dep(name = "yq.bzl", version = "0.4.0")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")
bazel_dep(name = "package_metadata", version = "0.0.13")

# Internal non-dev repositories / extensions.

prisma_host_constraints = use_repo_rule("//private/prisma:repositories.bzl", "prisma_host_constraints")

prisma_host_constraints(name = "prisma_host_constraints")

ibazel_info = use_repo_rule("//private/docker/compose:ibazel_info.bzl", "ibazel_info")

ibazel_info(name = "dh_buildlib_private_ibazel_info")

docker_config = use_repo_rule("//private/docker/lib:docker_config.bzl", "docker_config")

docker_config(name = "docker_config")

# Configure Node.js version: always take it from the root/main repository.
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version_from_nvmrc = "@@//:.nvmrc")  # buildifier: disable=canonical-repository

# Configure pnpm version: always take it from the root/main repository.
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(pnpm_version_from = "@@//:package.json")  # buildifier: disable=canonical-repository
use_repo(pnpm, "pnpm")

# npm / node_modules for buildlib itself.

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "dh_buildlib_private_npm",
    lifecycle_hooks_no_sandbox = False,
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "dh_buildlib_private_npm")

# npm / node_modules for the using repository.
# A basic npm setup is always required because we need at least prettier.
# It does not make sense to make notably .md formatting optional.
#
# In case we are building buildlib itself, this duplicates the
# `dh_buildlib_private_npm` repository as `npm` (which is not a problem).

# buildifier: disable=canonical-repository
npm.npm_translate_lock(
    name = "npm",
    lifecycle_hooks_no_sandbox = False,
    npmrc = "@@//:.npmrc",
    pnpm_lock = "@@//:pnpm-lock.yaml",
    verify_node_modules_ignored = "@@//:.bazelignore",
)

# use the repo for setup/defs/buildlib_setup.bzl
use_repo(npm, "npm")

# when buildlib is the root module, inject a fake npm repository.
# see the comment on setup/defs/buildlib_setup.bzl for more.
fake_npm_repository = use_repo_rule("//private/setup:fake_npm_repository.bzl", "fake_npm_repository")

fake_npm_repository(name = "fake_npm_repository")

override_repo(
    npm,
    npm = "fake_npm_repository",
)

# typescript for buildlib itself.

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(
    name = "dh_buildlib_private_typescript",
    ts_version_from = "@dh_buildlib_private_npm//:typescript/resolved.json",
)
use_repo(rules_ts_ext, "dh_buildlib_private_typescript")

# yq toolchain for the prisma engines repository.

yq_toolchain = use_extension("@yq.bzl//yq:extensions.bzl", "yq")
use_repo(
    yq_toolchain,
    "yq_darwin_amd64",
    "yq_darwin_arm64",
    "yq_linux_amd64",
    "yq_linux_arm64",
    "yq_linux_ppc64le",
    "yq_linux_s390x",
    "yq_windows_amd64",
)

prisma_version_info = use_repo_rule("//private/prisma:version_info.bzl", "version_info")

prisma_version_info(
    name = "prisma_version_info",
    pnpm_lock = "@@//:pnpm-lock.yaml",  # always from root module # buildifier: disable=canonical-repository
)

# prisma extension
#
# The extension is private, relevant bits are exposed via aliases
# (`//prisma:cli`) or rule attribute default values.
#
# - It pins prisma engines using the bazel lockfile.
# - It generates a different repository (which always fails) in case there is no
#   dependency on prisma.
#
# This is why we need an extension and not simply a use_repository.
prisma = use_extension("@dh_buildlib//private/prisma:prisma_extension.bzl", "prisma")
use_repo(prisma, "prisma")

# Dev dependencies

bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
bazel_dep(name = "rules_jvm_external", version = "7.2", dev_dependency = True)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven", dev_dependency = True)

# TODO(#1374, #1375): Re-align with tests/java if changed.
maven.install(
    artifacts = [
        "com.google.googlejavaformat:google-java-format:1.27.0",
    ],
    fail_if_repin_required = True,
    lock_file = "//:maven_install.json",
    resolver = "maven",
)
use_repo(maven, "maven")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci", dev_dependency = True)
oci.pull(
    name = "node_image",
    digest = "sha256:6449e19d8184d84062525b6a7524def03146c2cb04a7f08b076680d0e8e4240a",
    image = "index.docker.io/library/node",
    platforms = ["linux/amd64"],
    tag = "24.22.1",
)
oci.pull(
    name = "postgres_image",
    digest = "sha256:edb0c08dc33befd0262ab3b5cf1c4f3f8cfd8b09e88c05b45adee29d6761ddb6",
    image = "index.docker.io/library/postgres",
    platforms = ["linux/amd64"],
    tag = "18.6",
)
oci.pull(
    name = "nginx_image",
    digest = "sha256:6e67f8eaac94fc456588d4ff6c470d984841f5b5dc4279863d5cbe6ec5a60def",
    image = "index.docker.io/library/nginx",
    platforms = ["linux/amd64"],
    tag = "1.31.8",
)

# there are issues with prisma 5.x and alpine 3.21 regarding location of libssl, hence 3.20 was used here
# https://github.com/nodejs/docker-node/issues/2175
oci.pull(
    name = "node_alpine3.20_image",
    digest = "sha256:8fe019e0d57dbdce5f5c27c0b63d2775cf34b00e3755a7dea969802d7e0c2b25",
    image = "index.docker.io/library/node",
    platforms = ["linux/amd64"],
    tag = "24.1.0-alpine3.20",
)
use_repo(oci, "nginx_image", "nginx_image_linux_amd64", "node_alpine3.20_image", "node_alpine3.20_image_linux_amd64", "node_image", "node_image_linux_amd64", "postgres_image", "postgres_image_linux_amd64")

github_bin = use_extension("@dh_buildlib//private/github_bin:github_bin_extension.bzl", "github_bin_extension")
github_bin.download(
    name = "compose",
    filename_checksums = "checksums.txt",
    filename_pattern = "docker-compose-{os}-{arch}",
    git_tag = "v5.6.1",
    github_repo = "docker/compose",
    supported_arch = {
        "aarch64": "@platforms//cpu:arm64",
        "x86_64": "@platforms//cpu:x86_64",
    },
    supported_os = {
        "darwin": "@platforms//os:macos",
        "linux": "@platforms//os:linux",
    },
)
github_bin.download(
    name = "zot",
    filename_checksums = "checksums.sha256.txt",
    filename_pattern = "zot-{os}-{arch}-minimal",
    git_tag = "v2.1.22",
    github_repo = "project-zot/zot",
    supported_arch = {
        "amd64": "@platforms//cpu:x86_64",
        "arm64": "@platforms//cpu:aarch64",
    },
    supported_os = {
        "darwin": "@platforms//os:macos",
        "linux": "@platforms//os:linux",
    },
)
use_repo(github_bin, "compose", "zot")
