bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "dh_buildlib", version = "0.0.0")
local_path_override(
    module_name = "dh_buildlib",
    path = "../../buildlib",
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        # TODO(#1374): How do IDEs find this version?
        # Use toml files?
        # https://github.com/bazel-contrib/rules_jvm_external/blob/master/docs/bzlmod.md#declaring-dependencies-in-files
        "com.google.googlejavaformat:google-java-format:1.27.0",
    ],
    fail_if_repin_required = True,
    lock_file = "//:maven_install.json",
    # TODO(#1375): maven seems to be necessary here to resolve google java format.
    # Without it fails to resolve com_google_errorprone_error_prone_type_annotations.
    # Why?
    resolver = "maven",
)
use_repo(maven, "maven")
