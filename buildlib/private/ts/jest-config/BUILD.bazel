load("@aspect_rules_js//js:defs.bzl", "js_info_files")
load("//private:ts_library.bzl", "ts_library")

ts_library(
    name = "build",
    srcs = glob([
        "**/*.ts",
        "**/*.cts",
    ]),
    # Attention: Only add typing dependencies (see comments below).
    deps = [
        "//:node_modules/@types/node",
        "//:node_modules/jest",
    ],
)

# jest.config.js is generated by :build - we use this alias so we do not need to make ":build" public.
alias(
    name = "config",
    actual = "jest.config.js",
    visibility = ["//visibility:public"],
)

# Re-extract only the files we transpiled, not the dependenices:
# We use the dependencies for typing only and do explicitly not want
# to include them here.
# Real run-time dependencies (e.g. babel or identity-obj-proxy) are handled by
# the ts_test macro.
js_info_files(
    name = "deps",
    srcs = [":build"],
    include_npm_sources = False,
    include_sources = True,
    include_transitive_sources = False,
    include_transitive_types = False,
    include_types = False,
    visibility = ["//visibility:public"],
)
