load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

exports_files([
    "test-pnpm-lock.sh",
    "default.npmrc",
])

bzl_library(
    name = "bzl",
    srcs = glob(["**/*.bzl"]),
    visibility = [
        "//private/setup:__pkg__",
    ],
    deps = [
        "//private/setup:write_setup_source_file",
        "@aspect_rules_js//js:defs",
    ],
)

# Tiny wrapper around @pnpm:
# - Injects `--dir="$BUILD_WORKSPACE_DIRECTORY"`
# - Allows us to hide the @pnpm repository (and the extension).
sh_binary(
    name = "pnpm",
    srcs = [":pnpm.sh"],
    data = ["@pnpm"],
    env = {
        "PNPM_BIN": "$(rootpath @pnpm)",
    },
    visibility = ["//visibility:public"],
)
