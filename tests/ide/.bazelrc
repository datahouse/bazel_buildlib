# Configure remote cache (read only)
common --remote_upload_local_results=false
common --remote_cache=https://developer:fe5Haino9uonahtah5tohMahbaiShu@bazel-cache.datahouse.ch/

# Configure our own host platform detection.
common --host_platform=@dh_buildlib//:host_platform

# More aggressive sandboxing
common --sandbox_default_allow_network=false
common --incompatible_strict_action_env

# Look into directories for updates (so if you change a file in them,
# they are considered "changed").
startup --host_jvm_args=-DBAZEL_TRACK_SOURCE_DIRECTORIES=1

# Configure skipLibCheck for rules_ts
common --@dh_buildlib//ts:skipLibCheck=honor_tsconfig

# Configure java version
common --java_language_version=21
common --java_runtime_version=remotejdk_21
common --tool_java_language_version=21
common --tool_java_runtime_version=remotejdk_21

# Display test output if something fails
common --test_output=errors

# Workaround for https://github.com/bazelbuild/bazel/issues/28954
# ibazel currently no longer works without overriding the host_platform
# for additional information: https://git.datahouse.ch/datahouse/it-bazel/issues/1695
info --host_platform=

# Import for project specific bazelrc
# If you use this, please check (with an it-bazel issue), whether
# this should be a central option.
try-import %workspace%/project.bazelrc