load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@dh_buildlib//ts:defs.bzl", "json_to_ts", "ts_library")
load("@npm//:tsoa/package_json.bzl", _tsoa = "bin")

copy_file(
    name = "copy-my-version",
    src = "@dh_buildlib//my-version:myVersion.ts",
    out = "version/myVersion.ts",
)

_tsoa.tsoa(
    name = "tsoa",
    srcs = glob(["**/controller.ts"]) + [
        "index.ts",
        "tsoa.json",
        "tsoa-ioc.ts",
        "//prisma:client",
    ],
    outs = [
        "routes.ts",
        "swagger.json",
    ],
    args = ["spec-and-routes"],
    chdir = package_name(),
)

json_to_ts(
    name = "swagger",
    src = "swagger.json",
)

ts_library(
    name = "src",
    srcs = glob(["**/*.ts"]) + [
        ":copy-my-version",
        ":routes.ts",
        ":swagger.ts",
    ],
    visibility = ["//rest-api:__subpackages__"],
    deps = [
        "//:node_modules/@tsoa/runtime",
        "//:node_modules/@types/express",
        "//:node_modules/@types/node",
        "//:node_modules/@types/swagger-ui-express",
        "//:node_modules/express",
        "//:node_modules/swagger-ui-express",
        "//:node_modules/tsoa",
        "//prisma:client",
        "//prisma/rls",
    ],
)

alias(
    # Alias for the api-snapshot rule.
    # Not needed if you don't have that rule.
    name = "api.json",
    actual = "swagger.json",
    visibility = ["//rest-api:__pkg__"],
)
