{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  automerge: true,

  extends: [":semanticCommitsDisabled"],

  packageRules: [
    // Do not automerge major bazel lib updates in buildlib:
    // They are potentially breaking for downstream.
    {
      matchFileNames: ["buildlib/**"],
      matchManagers: ["bazel", "bazel-module"],
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    { matchPackageNames: ["node"], allowedVersions: "<= 22.13.0" },
  ],
  constraints: {
    pnpm: "9.15.2",
  },
}
