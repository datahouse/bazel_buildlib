load("@dh_buildlib//docker:defs.bzl", "dc_service_reference", "docker_compose")

docker_compose(
    name = "dc",
    src = "docker-compose.yml",
    project = "it-bazel-examples",
    deps = [
        "//api",
        "//frontend",
        "//prisma:db-migrate",
        "//proxy",
        "//proxy/blob-auth",
        "//rest-api",
        "@postgres_image_linux_amd64",
    ],
)

dc_service_reference(
    name = "db",
    dc = ":dc",
    port = 5432,
    service_name = "db",
    visibility = [
        "//prisma:__pkg__",
    ],
)
