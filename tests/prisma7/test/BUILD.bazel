load("@dh_buildlib//ts:defs.bzl", "ts_test")
load("@dh_buildlib//ts/docker:defs.bzl", "docker_image_for_ts_test")

docker_image_for_ts_test(
    name = "load_postgres_image",
    image = "@postgres_image_linux_amd64",
)

docker_image_for_ts_test(
    name = "load_node_image",
    image = "//:node_image",
)

ts_test(
    name = "test",
    srcs = glob(["**/*.ts"]),
    enable_jest_esm = True,  # requires ESM support due to "A dynamic import callback".
    tags = ["requires-docker"],
    deps = [
        ":load_node_image",
        ":load_postgres_image",
        "//:node_modules/@prisma/adapter-pg",
        "//:node_modules/@testcontainers/postgresql",
        "//:node_modules/testcontainers",
        "//prisma:client",
    ],
)
