bazel_dep(name = "aspect_rules_py", version = "1.13.0")
bazel_dep(name = "dh_buildlib", version = "0.0.0")
local_path_override(
    module_name = "dh_buildlib",
    path = "../../buildlib",
)

# TODO: force user repositories to choose an exact python version
bazel_dep(name = "rules_python", version = "2.4.5")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(pyproject_toml = "//:pyproject.toml")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    pyproject_toml = "//:pyproject.toml",
    # Named to avoid matching Renovate's default pip_requirements pattern.
    # https://docs.renovatebot.com/modules/manager/pip_requirements/#default-config
    requirements_lock = "//:buildlib_pip_lock.txt",
)
use_repo(pip, "pypi")
